# JWT Configuration (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production

# MongoDB Atlas Configuration (include a database name after the host, e.g. .../shikshanetra?retryWrites=true)
MONGODB_URI=

# Admin Secret (protects POST /api/db/init)
ADMIN_SECRET=your-admin-secret-for-db-operations

# Internal Service Configuration (job restart cron + startup; must match the GitHub Actions secret)
INTERNAL_SERVICE_KEY=your-internal-service-key-change-this-in-production
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Google OAuth Client ID (ends in .apps.googleusercontent.com — NOT the GOCSPX- client secret)
GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com

# Cloudinary (unsigned upload preset, resource type: video)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=Shikshanetra
NEXT_PUBLIC_CLOUDINARY_UPLOAD_FOLDER=video
